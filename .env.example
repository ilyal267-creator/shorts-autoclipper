# Model. Unset ANTHROPIC_API_KEY and the run falls back to the [MOCK] provider,
# which produces placeholder text that must never be published.
ANTHROPIC_API_KEY=
SHORTS_PROVIDER=            # set to "mock" to force the offline provider
SHORTS_DRY_RUN=             # set to "1" to run every stage but send nothing

# TikTok Content Posting API (video.publish scope)
TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACY_LEVEL=SELF_ONLY   # unaudited apps may only post privately

# Instagram Graph API (instagram_content_publish). account_id = IG user id.
IG_ACCESS_TOKEN=
PUBLIC_ASSET_BASE_URL=           # Instagram fetches the file over HTTP from here

# YouTube Data API v3 (youtube.upload). Short-lived OAuth access token.
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_PRIVACY_STATUS=private

# ElevenLabs voiceover (voiceover.enabled in the run config). Needs text-to-speech and
# voices-read permission on the key.
ELEVENLABS_API_KEY=
